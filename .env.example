# Runtime secrets. Copy to .env on the VPS; never commit the real file.
ODOO_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PASSWORD=replace-with-the-same-strong-database-password
ODOO_ADMIN_PASSWORD=replace-with-a-strong-odoo-master-password
ODOO_DB_NAME=pap
ODOO_MODULES="gpt_odoo_bridge muk_web_appsbar muk_web_chatter muk_web_colors muk_web_dialog muk_web_group muk_web_refresh muk_web_theme"
HEALTHCHECK_URL=https://odoo.example.com/web/login
# Secret used only by the GPT Action (Authorization: Bearer ...). Generate a unique value on the VPS.
GPT_ODOO_API_KEY=replace-with-a-long-random-gpt-api-key
# Created by scripts/setup-gpt-user.sh on the VPS. Do not use an administrator account.
GPT_ODOO_USER_ID=0
GPT_ODOO_USER_LOGIN=gpt-odoo-integration@pupuia.local
